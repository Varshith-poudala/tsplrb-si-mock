# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/tsplrb_cbt?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.mongodb.net/tsplrb_cbt?retryWrites=true&w=majority

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_random_string_here_32_chars

# Google OAuth (from console.cloud.google.com)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Super Admin Emails (comma-separated, automatically granted admin & full access)
ADMIN_EMAILS=varshithpoudala@gmail.com

# Razorpay Payment Gateway (Live production or test mode)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
TEST_SERIES_PRICE=99

# Email Delivery Configuration (Nodemailer SMTP for Password Recovery OTP)
# Option A: Gmail SMTP using a Google App Password (recommended for quick setup):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_gmail_app_password
SMTP_FROM="TSPLRB SI Mock Test Series <your_email@gmail.com>"

# Option B: Dedicated transactional SMTP provider (Brevo / SendGrid / Amazon SES):
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_login
# SMTP_PASS=your_smtp_key
# SMTP_FROM="TSPLRB SI Mock Test Series <notifications@yourdomain.com>"
